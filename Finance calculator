#include <iostream>
#include <iomanip>
#include <cmath>
#include <string>
using namespace std;

double calculateTax(double grossIncome);
double calculateTax(double grossIncome, double deductionRate);
double computeInterest(double principal, double annualRate, int years);
double computeInterest(double principal, double annualRate, int years, int compoundPerYear);
void printReport(double netIncome, double totalInterest);
void printReport(string userName, double grossIncome, double totalTax, double netIncome, double principal, double totalInterest);
double getPositiveInput(string promptMessage);

int main() {
    string name;
    double gross, principal, rate, tax, net, interest;
    int years;
    char answer;
    int choice;
    int freq;

    cout << "=====================================================" << endl;
    cout << "    MODULAR PERSONAL FINANCE CALCULATOR (C++)" << endl;
    cout << "=====================================================" << endl;
    cout << endl;

    cout << "Enter your full name: ";
    getline(cin, name);

    gross = getPositiveInput("Enter Gross Annual Income ($): ");
    principal = getPositiveInput("Enter Initial Investment Principal ($): ");
    rate = getPositiveInput("Enter Expected Annual Rate (decimal, e.g. 0.07): ");
    years = getPositiveInput("Enter Investment Duration (years): ");

    cout << endl;
    cout << "Do you have a custom tax rate? (y/n): ";
    cin >> answer;
    if (answer == 'y') {
        double customRate;
        cout << "Enter your custom tax rate (e.g. 0.22): ";
        cin >> customRate;
        tax = calculateTax(gross, customRate);
    }
    else {
        tax = calculateTax(gross);
    }

    net = gross - tax;

    cout << endl;
    cout << "Select Interest Model:" << endl;
    cout << "  1. Simple Interest" << endl;
    cout << "  2. Compound Interest" << endl;
    cout << "Choice (1 or 2): ";
    cin >> choice;
    if (choice == 1) {
        interest = computeInterest(principal, rate, years);
    }
    else if (choice == 2) {
        cout << "Enter compound frequency per year (e.g., 12 for monthly, 4 for quarterly): ";
        cin >> freq;
        interest = computeInterest(principal, rate, years, freq);
    }

    printReport(net, interest);
    printReport(name, gross, tax, net, principal, interest);

    return 0;
}

double calculateTax(double grossIncome) {
    double tax = grossIncome * 0.15;
    return tax;
}

double calculateTax(double grossIncome, double deductionRate) {
    double tax = grossIncome * deductionRate;
    return tax;
}

double computeInterest(double principal, double annualRate, int years) {
    double interest = principal * annualRate * years;
    return interest;
}

double computeInterest(double principal, double annualRate, int years, int compoundPerYear) {
    double amount = principal * pow(1 + (annualRate / compoundPerYear), compoundPerYear * years);
    double interest = amount - principal;
    return interest;
}

void printReport(double netIncome, double totalInterest) {
    cout << endl;
    cout << "-----------------------------------------------------" << endl;
    cout << "QUICK FINANCIAL SNAPSHOT" << endl;
    cout << "-----------------------------------------------------" << endl;
    cout << fixed << setprecision(2);
    cout << "Take-Home Net Income:  $" << netIncome << endl;
    cout << "Projected Interest:    $" << totalInterest << endl;
    cout << endl;
}

void printReport(string userName, double grossIncome, double totalTax, double netIncome, double principal, double totalInterest) {
    double taxes = grossIncome - netIncome;
    double finalBalance = principal + totalInterest;

    cout << "=====================================================" << endl;
    cout << "DETAILED FINANCIAL STATEMENT FOR: " << userName << endl;
    cout << "=====================================================" << endl;
    cout << fixed << setprecision(2);
    cout << "Gross Annual Income:   $" << grossIncome << endl;
    cout << "Total Taxes Withheld:  $" << taxes << endl;
    cout << "Take-Home Pay (Net):   $" << netIncome << endl;
    cout << "-----------------------------------------------------" << endl;
    cout << "Initial Investment:    $" << principal << endl;
    cout << "Interest Accrued:      $" << totalInterest << endl;
    cout << "Final Account Balance: $" << finalBalance << endl;
    cout << "=====================================================" << endl;
}

double getPositiveInput(string promptMessage) {
    double value;
    cout << promptMessage;
    cin >> value;
    while (value <= 0) {
        cout << promptMessage;
        cin >> value;
    }
    return value;
}
